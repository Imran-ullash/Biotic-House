# ===================================================
# Brevo (formerly Sendinblue) Configuration
# ===================================================
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# The sender email address verified in your Brevo account
BREVO_SENDER_EMAIL=support@biotichouse.com

# Where contact form messages should be delivered
BREVO_ADMIN_EMAIL=admin@biotichouse.com

# (Optional) Brevo List ID to add newsletter subscribers into
BREVO_LIST_ID=2
